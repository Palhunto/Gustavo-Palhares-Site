---
import { homepageEditorialCopy } from "../../config/homepage.ts";
import {
  formatCompactEditorialDate,
  formatLocation,
  workPresentation,
} from "../../lib/content/publication.ts";
import type { HomepageModel } from "../../lib/homepage/model.ts";
import { publicRoutes } from "../../lib/routes/public.ts";
import { workCoverViewTransitionName } from "../../lib/view-transitions/work-cover.ts";
import EditorialImage from "../editorial/EditorialImage.astro";
import HomeSectionHeading from "./HomeSectionHeading.astro";

interface Props {
  model: HomepageModel;
}

const { model } = Astro.props;
---

<section
  id="trabalhos"
  class="home-moment home-works"
  aria-labelledby="home-works-title"
  data-motion-section="trabalhos"
  data-home-works-motion
>
  <HomeSectionHeading
    id="home-works-title"
    number="02"
    title="Trabalhos"
    note={homepageEditorialCopy.worksCountLabel(model.works.length)}
    motion="works"
  />
  <div class="home-works__list">
    {
      model.works.map((work, index) => {
        const presentation = workPresentation(work.id, work.data);
        const location = formatLocation(work.data.location);
        const viewTransitionName = workCoverViewTransitionName(work.data.slug);
        return (
          <>
            {index > 0 && (
              <span
                class="home-work__divider"
                data-home-works-divider
                aria-hidden="true"
              />
            )}
            <article
              class:list={[
                "home-work",
                index === 0 ? "home-work--lead" : "home-work--reverse",
              ]}
              data-motion-item={`work-${index + 1}`}
              data-home-works-item={index === 0 ? "lead" : "reverse"}
            >
              <a
                class="home-work__media"
                href={publicRoutes.trabalho(work.data.slug)}
                aria-label={`Ver ${work.data.title}`}
                data-home-works-image
              >
                <EditorialImage
                  asset={work.data.cover}
                  layout="sequence"
                  showCaption={false}
                  viewTransitionName={viewTransitionName}
                />
              </a>
              <div class="home-work__copy">
                <p
                  class="home-work__number number-stable"
                  data-home-works-eyebrow
                >
                  {String(index + 1).padStart(2, "0")}
                </p>
                <p class="home-work__format type-label" data-home-works-eyebrow>
                  {presentation.formatLabel}
                </p>
                <h3 class="home-work__title" data-home-works-title>
                  <a href={publicRoutes.trabalho(work.data.slug)}>
                    {work.data.title}
                  </a>
                </h3>
                <p class="home-work__summary" data-home-works-summary>
                  {work.data.summary}
                </p>
                <dl class="home-work__meta type-meta" data-home-works-meta>
                  <div>
                    <dt>Data</dt>
                    <dd>
                      {formatCompactEditorialDate(
                        work.data.date,
                        work.data.dateEnd,
                      )}
                    </dd>
                  </div>
                  {location && (
                    <div>
                      <dt>Cidade</dt>
                      <dd>{location}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Contexto</dt>
                    <dd>{presentation.contextLabel}</dd>
                  </div>
                </dl>
                <a
                  class="home-work__cta type-nav"
                  href={publicRoutes.trabalho(work.data.slug)}
                  data-home-works-cta
                >
                  Ver trabalho <span aria-hidden="true">⟶</span>
                </a>
              </div>
            </article>
          </>
        );
      })
    }
  </div>
</section>
