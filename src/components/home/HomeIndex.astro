---
import {
  homepageEditorialCopy,
  type HomepagePresenceItem,
} from "../../config/homepage.ts";
import type { HomepageModel } from "../../lib/homepage/model.ts";
import { publicRoutes } from "../../lib/routes/public.ts";
import HomeSectionHeading from "./HomeSectionHeading.astro";

interface Props {
  model: HomepageModel;
}

const { model } = Astro.props;

function presenceItem(key: HomepagePresenceItem["key"]): HomepagePresenceItem {
  const item = homepageEditorialCopy.presence.find(
    (candidate) => candidate.key === key,
  );
  if (!item) throw new Error(`Item ausente no índice da homepage: ${key}.`);
  return item;
}

const sobre = presenceItem("sobre");
const contato = presenceItem("contato");
const indexGroups = [
  {
    item: sobre,
    details: homepageEditorialCopy.indexGroups.sobre.items,
    action: homepageEditorialCopy.indexGroups.sobre.action,
  },
  {
    item: contato,
    details: homepageEditorialCopy.indexGroups.contato.items,
    action: homepageEditorialCopy.indexGroups.contato.action,
  },
] as const;
---

<section
  id="indice"
  class="home-moment home-index"
  aria-labelledby="home-index-title"
  data-motion-section="indice"
  data-home-index-motion
>
  <HomeSectionHeading
    id="home-index-title"
    number="04"
    title="Índice"
    note={homepageEditorialCopy.indexLabel}
    motion="index"
  />

  <div
    class="home-index__list"
    data-motion-item="index-list"
    data-home-index-list
  >
    <article
      class="home-index__item home-index__item--works"
      data-motion-item="index-item"
      data-home-index-item="trabalhos"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>
        <a class="home-index__text-link" href={publicRoutes.trabalhosIndex}
          >Trabalhos</a
        >
      </h3>
      <ol class="home-index__works">
        {
          model.works.map((work, index) => (
            <li data-home-index-work data-home-index-support>
              <span class="number-stable" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <a
                class="home-index__text-link"
                href={publicRoutes.trabalho(work.data.slug)}
              >
                {work.data.title}
              </a>
            </li>
          ))
        }
      </ol>
      <a
        class="home-index__action type-nav"
        href={publicRoutes.trabalhosIndex}
        data-home-index-support
      >
        Ver todos <span aria-hidden="true">⟶</span>
      </a>
    </article>

    {
      indexGroups.map(({ item, details, action }) => (
        <article
          class="home-index__item"
          data-motion-item="index-item"
          data-home-index-item={item.key}
        >
          <span
            class="home-index__rule home-index__rule--inline"
            data-home-index-rule="inline"
            aria-hidden="true"
          />
          <span
            class="home-index__rule home-index__rule--block"
            data-home-index-rule="block"
            aria-hidden="true"
          />
          <h3 data-home-index-item-title>
            <a class="home-index__text-link" href={item.href}>
              {item.title}
            </a>
          </h3>
          <ul class="home-index__details" role="list">
            {details.map((detail) => (
              <li data-home-index-support>
                <a class="home-index__detail" href={item.href}>
                  <span class="home-index__detail-icon" aria-hidden="true">
                    {detail.icon === "profile" && (
                      <svg viewBox="0 0 24 24" focusable="false">
                        <circle cx="12" cy="7.5" r="3.5" />
                        <path d="M4.5 20c.4-4.2 3-6.4 7.5-6.4s7.1 2.2 7.5 6.4Z" />
                      </svg>
                    )}
                    {detail.icon === "document" && (
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M6 3h8l4 4v14H6Z" />
                        <path d="M14 3v5h4" />
                      </svg>
                    )}
                    {detail.icon === "send" && (
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="m3 11 18-8-7.5 18-2.8-7.7Z" />
                        <path d="M10.7 13.3 21 3" />
                      </svg>
                    )}
                    {detail.icon === "briefcase" && (
                      <svg viewBox="0 0 24 24" focusable="false">
                        <rect x="3" y="7" width="18" height="13" rx="1" />
                        <path d="M8 7V4h8v3M3 11h18" />
                      </svg>
                    )}
                  </span>
                  <span class="home-index__detail-copy">
                    <strong>{detail.title}</strong>
                    <span>{detail.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a
            class="home-index__action type-nav"
            href={item.href}
            data-home-index-support
          >
            {action} <span aria-hidden="true">⟶</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
