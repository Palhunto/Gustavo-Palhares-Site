---
import {
  homepageEditorialCopy,
  type HomepagePresenceItem,
} from "../../config/homepage.ts";
import type { HomepageModel } from "../../lib/homepage/model.ts";
import { publicRoutes } from "../../lib/routes/public.ts";
import HomeSectionHeading from "./HomeSectionHeading.astro";

interface Props {
  model: HomepageModel;
}

const { model } = Astro.props;

function presenceItem(key: HomepagePresenceItem["key"]): HomepagePresenceItem {
  const item = homepageEditorialCopy.presence.find(
    (candidate) => candidate.key === key,
  );
  if (!item) throw new Error(`Item ausente no índice da homepage: ${key}.`);
  return item;
}

const caderno = presenceItem("caderno");
const colecoes = presenceItem("colecoes");
const edicoes = presenceItem("edicoes");
const sobre = presenceItem("sobre");
const contato = presenceItem("contato");
---

<section
  id="indice"
  class="home-moment home-index"
  aria-labelledby="home-index-title"
  data-motion-section="indice"
  data-home-index-motion
>
  <HomeSectionHeading
    id="home-index-title"
    number="04"
    title="Índice"
    note={homepageEditorialCopy.indexLabel}
    motion="index"
  />

  <div
    class="home-index__list"
    data-motion-item="index-list"
    data-home-index-list
  >
    <article
      class="home-index__item home-index__item--works"
      data-motion-item="index-item"
      data-home-index-item="trabalhos"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>
        <a class="home-index__text-link" href={publicRoutes.trabalhosIndex}
          >Trabalhos</a
        >
      </h3>
      <ol class="home-index__works">
        {
          model.works.map((work, index) => (
            <li data-home-index-work>
              <span class="number-stable" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <a
                class="home-index__text-link"
                href={publicRoutes.trabalho(work.data.slug)}
              >
                {work.data.title.split(" — ")[0]}
              </a>
            </li>
          ))
        }
      </ol>
      <a
        class="home-index__action type-nav"
        href={publicRoutes.trabalhosIndex}
        data-home-index-item-action
      >
        Ver todos <span aria-hidden="true">⟶</span>
      </a>
    </article>

    <article
      class="home-index__item"
      data-motion-item="index-item"
      data-home-index-item="caderno"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>
        <a class="home-index__text-link" href={caderno.href}>{caderno.title}</a>
      </h3>
      <p class="home-index__status" data-home-index-item-state>
        {homepageEditorialCopy.indexStates.caderno}
      </p>
      <a
        class="home-index__action type-nav"
        href={caderno.href}
        data-home-index-item-action
      >
        {caderno.action}
        <span aria-hidden="true">⟶</span>
      </a>
    </article>

    <article
      class="home-index__item"
      data-motion-item="index-item"
      data-home-index-item="colecoes"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>
        <a class="home-index__text-link" href={colecoes.href}
          >{colecoes.title}</a
        >
      </h3>
      <p class="home-index__status" data-home-index-item-state>
        {homepageEditorialCopy.indexStates.colecoes}
      </p>
      <a
        class="home-index__action type-nav"
        href={colecoes.href}
        data-home-index-item-action
      >
        {colecoes.action}
        <span aria-hidden="true">⟶</span>
      </a>
    </article>

    <article
      class="home-index__item"
      data-motion-item="index-item"
      data-home-index-item="edicoes"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>
        <a class="home-index__text-link" href={edicoes.href}>{edicoes.title}</a>
      </h3>
      <p class="home-index__status" data-home-index-item-state>
        {homepageEditorialCopy.indexStates.edicoes}
      </p>
      <a
        class="home-index__action type-nav"
        href={edicoes.href}
        data-home-index-item-action
      >
        {edicoes.action}
        <span aria-hidden="true">⟶</span>
      </a>
    </article>

    <article
      class="home-index__item"
      data-motion-item="index-item"
      data-home-index-item="sobre-contato"
    >
      <span
        class="home-index__rule home-index__rule--inline"
        data-home-index-rule="inline"
        aria-hidden="true"></span>
      <span
        class="home-index__rule home-index__rule--block"
        data-home-index-rule="block"
        aria-hidden="true"></span>
      <h3 data-home-index-item-title>Sobre &amp; Contato</h3>
      <ul class="home-index__links" role="list">
        <li data-home-index-item-sublink>
          <a class="home-index__text-link" href={sobre.href}>{sobre.title}</a>
        </li>
        <li data-home-index-item-sublink>
          <a class="home-index__text-link" href={contato.href}
            >{contato.title}</a
          >
        </li>
      </ul>
      <a
        class="home-index__action type-nav"
        href={sobre.href}
        data-home-index-item-action
      >
        Ir para <span aria-hidden="true">⟶</span>
      </a>
    </article>
  </div>
</section>
