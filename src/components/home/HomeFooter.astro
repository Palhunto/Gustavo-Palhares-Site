---
import { siteConfig } from "../../config/site.ts";

const year = new Date().getUTCFullYear();
---

<footer class="site-footer home-footer type-meta" data-home-footer-motion>
  <span class="home-footer__rule" data-home-footer-rule aria-hidden="true"
  ></span>

  <div class="home-footer__identity" data-home-footer-group>
    <p class="home-footer__monogram" aria-hidden="true">GP</p>
    <div>
      <p class="home-footer__name">{siteConfig.name}</p>
      <p>{siteConfig.shortIdentity}</p>
    </div>
  </div>

  <p class="home-footer__copyright number-stable" data-home-footer-group>
    {`© ${year} ${siteConfig.name}. Todos os direitos reservados.`}
  </p>

  <a
    class="home-footer__email"
    href="mailto:gustavo.palhares49@gmail.com"
    data-home-footer-group
  >
    gustavo.palhares49@gmail.com
  </a>

  <nav
    class="home-footer__channels"
    aria-label="Canais de contato"
    data-home-footer-group
  >
    <a
      href="https://www.instagram.com/gustavopalharess/"
      aria-label="Instagram de Gustavo Palhares"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="4" y="4" width="16" height="16" rx="4"></rect>
        <circle cx="12" cy="12" r="3.5"></circle>
        <circle cx="17.3" cy="6.8" r="0.8" class="home-footer__icon-dot"
        ></circle>
      </svg>
    </a>
    <a
      href="mailto:gustavo.palhares49@gmail.com"
      aria-label="Enviar email para Gustavo Palhares"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14"></rect>
        <path d="m4 6 8 7 8-7"></path>
      </svg>
    </a>
  </nav>
</footer>
