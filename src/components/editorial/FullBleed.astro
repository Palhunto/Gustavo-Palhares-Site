---
import {
  getContentMediaResolver,
  type EditorialMediaInput,
} from "../../lib/media/index.ts";
import { resolveEditorialNumber } from "../../lib/mdx/editorial-numbers.ts";
import FigureCaption from "./_FigureCaption.astro";
import MediaPicture from "./_MediaPicture.astro";

interface Props {
  asset: EditorialMediaInput;
  priority?: boolean;
  creditMode?: "auto" | "document";
  lightbox?: boolean;
  number?: string;
}

const {
  asset,
  priority = false,
  creditMode = "auto",
  lightbox = false,
  number,
} = Astro.props;
const resolver = await getContentMediaResolver();
const media = resolver.resolve(asset, { layout: "full-bleed", priority });
const editorialNumber = resolveEditorialNumber(number, "FullBleed");
---

<figure class="full-bleed" data-media-id={media.id} data-work-figure>
  <MediaPicture
    media={media}
    lightboxNumber={lightbox ? editorialNumber : undefined}
  />
  <FigureCaption
    media={media}
    number={editorialNumber}
    showCredit={creditMode === "auto"}
  />
</figure>
