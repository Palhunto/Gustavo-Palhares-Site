---
import {
  getContentMediaResolver,
  type EditorialMediaInput,
} from "../../lib/media/index.ts";
import { resolveEditorialNumber } from "../../lib/mdx/editorial-numbers.ts";
import type { WorkCoverViewTransitionName } from "../../lib/view-transitions/work-cover.ts";
import FigureCaption from "./_FigureCaption.astro";
import MediaPicture from "./_MediaPicture.astro";

interface Props {
  asset: EditorialMediaInput;
  archiveNumber?: string;
  priority?: boolean;
  creditMode?: "auto" | "document";
  lightbox?: boolean;
  number?: string;
  viewTransitionName?: WorkCoverViewTransitionName;
}

const {
  asset,
  archiveNumber,
  priority = true,
  creditMode = "auto",
  lightbox = false,
  number,
  viewTransitionName,
} = Astro.props;
const resolver = await getContentMediaResolver();
const media = resolver.resolve(asset, { layout: "lead", priority });
const editorialNumber = resolveEditorialNumber(number, "LeadImage");
---

<figure class="lead-image" data-media-id={media.id}>
  {
    archiveNumber && (
      <p class="lead-image__marker type-meta" aria-label="Número de arquivo">
        {archiveNumber}
      </p>
    )
  }
  {
    viewTransitionName ? (
      <div
        class="work-cover-transition-frame"
        style={`view-transition-name: ${viewTransitionName};`}
      >
        <MediaPicture
          media={media}
          lightboxNumber={lightbox ? editorialNumber : undefined}
        />
      </div>
    ) : (
      <MediaPicture
        media={media}
        lightboxNumber={lightbox ? editorialNumber : undefined}
      />
    )
  }
  <FigureCaption
    media={media}
    number={editorialNumber}
    showCredit={creditMode === "auto"}
  />
</figure>
