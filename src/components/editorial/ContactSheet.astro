---
import {
  getContentMediaResolver,
  parseMediaList,
  type EditorialMediaInput,
} from "../../lib/media/index.ts";
import { resolveEditorialNumbers } from "../../lib/mdx/editorial-numbers.ts";
import MediaPicture from "./_MediaPicture.astro";

interface Props {
  assets: string | readonly EditorialMediaInput[];
  label?: string;
  lightbox?: boolean;
  numbers?: string | readonly string[];
}

const {
  assets,
  label = "Folha de contato",
  lightbox = false,
  numbers,
} = Astro.props;
const inputs = parseMediaList(assets);
if (inputs.length < 4 || inputs.length > 12) {
  throw new Error("ContactSheet exige entre 4 e 12 mídias.");
}
const resolver = await getContentMediaResolver();
const media = resolver.resolveMany(inputs, { layout: "thumbnail" });
const editorialNumbers = resolveEditorialNumbers(
  numbers,
  media.length,
  "ContactSheet",
);
---

<figure class="contact-sheet" data-work-contact-sheet>
  <figcaption class="contact-sheet__heading type-label">
    <span>{label}</span>
  </figcaption>
  <ol class="contact-sheet__grid">
    {
      media.map((item, index) => (
        <li
          class="contact-sheet__item"
          data-media-id={item.id}
          data-work-figure
        >
          <MediaPicture
            media={item}
            lightboxNumber={lightbox ? editorialNumbers[index] : undefined}
          />
          <p
            class="contact-sheet__index editorial-photo-number type-meta number-stable"
            data-work-number
          >
            {editorialNumbers[index]}
          </p>
        </li>
      ))
    }
  </ol>
</figure>
