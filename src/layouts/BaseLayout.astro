---
import SiteFooter from "../components/global/SiteFooter.astro";
import SiteHeader from "../components/global/SiteHeader.astro";
import SeoHead from "../components/global/SeoHead.astro";
import HomeFooter from "../components/home/HomeFooter.astro";
import WorkCoverViewTransitions from "../components/global/WorkCoverViewTransitions.astro";
import type { WorkCoverViewTransitionName } from "../lib/view-transitions/work-cover.ts";
import type {
  RobotsDirective,
  SocialImageMetadata,
  StructuredData,
} from "../lib/seo/metadata.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: RobotsDirective;
  canonical?: boolean;
  socialImage?: SocialImageMetadata;
  type?: "website" | "article";
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: StructuredData;
  variant?:
    | "standard"
    | "provisional"
    | "utility"
    | "works-index"
    | "caderno-index"
    | "collections-index"
    | "about-page"
    | "contact-page"
    | "homepage";
  showHeader?: boolean;
  viewTransitions?: boolean;
  viewTransitionName?: WorkCoverViewTransitionName;
}

const {
  title,
  description,
  robots,
  canonical,
  socialImage,
  type = "website",
  author,
  publishedTime,
  modifiedTime,
  structuredData,
  variant = "standard",
  showHeader = true,
  viewTransitions = false,
  viewTransitionName,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      robots={robots}
      canonical={canonical}
      socialImage={socialImage}
      type={type}
      author={author}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      structuredData={structuredData}
    />
    {
      viewTransitions && (
        <WorkCoverViewTransitions activeName={viewTransitionName} />
      )
    }
  </head>
  <body class:list={["public-page", `public-page--${variant}`]}>
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
    <div class="site-frame">
      {showHeader && <SiteHeader currentPath={Astro.url.pathname} />}
      <main id="conteudo-principal" class="site-main">
        <slot />
      </main>
      {variant === "homepage" ? <HomeFooter /> : <SiteFooter />}
    </div>
  </body>
</html>
