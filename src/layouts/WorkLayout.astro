---
import Credits from "../components/editorial/Credits.astro";
import LeadImage from "../components/editorial/LeadImage.astro";
import WorkLightbox from "../components/editorial/WorkLightbox.astro";
import WorkMotion from "../components/editorial/WorkMotion.astro";
import { publicRoutes } from "../lib/routes/public.ts";
import type {
  SocialImageMetadata,
  StructuredData,
} from "../lib/seo/metadata.ts";
import type { WorkCoverViewTransitionName } from "../lib/view-transitions/work-cover.ts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  summary: string;
  metaDescription?: string;
  archiveNumber: string;
  dateLabel: string;
  location?: string;
  formatLabel: string;
  contextLabel: string;
  cover: unknown;
  credits: readonly { role: string; name: string }[];
  archived?: boolean;
  socialImage?: SocialImageMetadata;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: StructuredData;
  viewTransitionName?: WorkCoverViewTransitionName;
  motion?: "standard" | "nephillin" | "feira" | "kauan";
}

const {
  title,
  summary,
  metaDescription,
  archiveNumber,
  dateLabel,
  location,
  formatLabel,
  contextLabel,
  cover,
  credits,
  archived = false,
  socialImage,
  publishedTime,
  modifiedTime,
  structuredData,
  viewTransitionName,
  motion,
} = Astro.props;
const [titleLead, ...titleRemainder] = title.split(" — ");
const titleContinuation = titleRemainder.join(" — ");
---

<BaseLayout
  title={title}
  description={metaDescription ?? summary}
  type="article"
  socialImage={socialImage}
  author="Gustavo Palhares"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
  viewTransitions={Boolean(viewTransitionName)}
  viewTransitionName={viewTransitionName}
>
  <article class="work-document" data-work-page data-work-motion={motion}>
    <header class="work-header" data-work-intro>
      <div class="work-header__marker">
        <p class="type-label">Trabalho fotográfico</p>
        <p class="type-meta number-stable">{archiveNumber}</p>
        {archived && <p class="archive-status type-label">Arquivado</p>}
      </div>
      <div class="work-header__main">
        <div class="work-header__copy">
          <h1 class="type-display" data-work-title>
            {
              motion === "feira" ? (
                <span data-work-title-clip>
                  <span data-work-title-line>{title}</span>
                </span>
              ) : (
                <>
                  {titleLead}
                  {titleContinuation && (
                    <>
                      {" "}
                      —
                      <span class="work-title__continuation">
                        {" "}
                        {titleContinuation}
                      </span>
                    </>
                  )}
                </>
              )
            }
          </h1>
          <p class="type-intro" data-work-summary>{summary}</p>
        </div>
        <dl class="work-header__metadata type-meta" data-work-metadata>
          <div><dt>Data</dt><dd>{dateLabel}</dd></div>
          {
            location && (
              <div>
                <>
                  <dt>Cidade</dt>
                  <dd>{location}</dd>
                </>
              </div>
            )
          }
          <div><dt>Formato</dt><dd>{formatLabel}</dd></div>
          <div><dt>Contexto</dt><dd>{contextLabel}</dd></div>
        </dl>
      </div>
    </header>

    <div class="work-opening" data-work-lead>
      <LeadImage
        asset={cover as never}
        number="01"
        creditMode="document"
        lightbox={Boolean(motion)}
        viewTransitionName={viewTransitionName}
      />
    </div>

    <div class="work-body" data-work-gallery>
      <slot />
    </div>

    <div class="work-credits" data-work-credit>
      <Credits items={credits} variant="colophon" />
    </div>

    <nav
      class="work-continuity"
      aria-label="Continuidade dos trabalhos"
      data-work-continuity
    >
      <a
        class="work-continuity__link link-editorial"
        href={publicRoutes.trabalhosIndex}
      >
        <span>VER TODOS OS TRABALHOS</span>
        <span class="link-editorial__mark" aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
  {motion && <WorkLightbox title={title} />}
  {motion && <WorkMotion />}
</BaseLayout>
