---
import { getCollection } from "astro:content";

import HomePage from "../components/home/HomePage.astro";
import { siteConfig } from "../config/site.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildInstant } from "../lib/content/publication.ts";
import { buildHomepageModel } from "../lib/homepage/model.ts";
import { configuredSiteUrl } from "../lib/seo/site-url.ts";
import { websiteStructuredData } from "../lib/seo/structured-data.ts";

const at = buildInstant();
const works = await getCollection("trabalhos");
const model = buildHomepageModel({
  works,
  at,
});
const structuredData = websiteStructuredData(configuredSiteUrl());
---

<BaseLayout
  description={siteConfig.description}
  variant="homepage"
  robots="index, follow"
  structuredData={structuredData}
  viewTransitions
>
  <HomePage model={model} />
</BaseLayout>

<script>
  import { MOTION_LIFECYCLE_EVENTS } from "../lib/motion/config.ts";
  import { initializeHomepageMotion } from "../lib/motion/homepage.ts";

  const cleanup = initializeHomepageMotion(document);
  window.addEventListener(MOTION_LIFECYCLE_EVENTS.pageHide, cleanup, {
    once: true,
  });
</script>
