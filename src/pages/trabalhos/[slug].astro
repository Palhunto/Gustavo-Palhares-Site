---
import { getCollection, render, type CollectionEntry } from "astro:content";

import WorkLayout from "../../layouts/WorkLayout.astro";
import {
  buildInstant,
  formatEditorialDate,
  formatLocation,
  isIndividuallyPublic,
  workPresentation,
} from "../../lib/content/publication.ts";
import { MDX_COMPONENT_REGISTRY } from "../../lib/mdx/registry.ts";
import { resolveSocialImage } from "../../lib/seo/social-image.ts";
import { configuredSiteUrl } from "../../lib/seo/site-url.ts";
import { creativeWorkStructuredData } from "../../lib/seo/structured-data.ts";
import { workCoverViewTransitionName } from "../../lib/view-transitions/work-cover.ts";

export async function getStaticPaths() {
  const at = buildInstant();
  const allWorks = await getCollection("trabalhos");
  const individual = allWorks.filter((entry) =>
    isIndividuallyPublic(entry, at),
  );
  return individual.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"trabalhos">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const presentation = workPresentation(entry.id, entry.data);
const at = buildInstant();
const siteUrl = configuredSiteUrl();
const socialImage = await resolveSocialImage(entry.data.cover, at, siteUrl);
const structuredData = creativeWorkStructuredData(
  entry,
  at,
  siteUrl,
  socialImage,
);
const credits = entry.data.credits.flatMap((credit) =>
  credit.name ? [{ role: credit.role, name: credit.name }] : [],
);
const viewTransitionName = workCoverViewTransitionName(entry.data.slug);
const motion =
  entry.id === "nephillin-uma-cobertura-sem-credencial"
    ? "nephillin"
    : entry.id === "feira-do-rolo"
      ? "feira"
      : entry.id === "kauan-felix-uma-noite-de-k-1"
        ? "kauan"
        : "standard";
---

<WorkLayout
  title={entry.data.title}
  summary={entry.data.summary}
  metaDescription={entry.data.seo?.description}
  archiveNumber={entry.data.archiveNumber}
  dateLabel={formatEditorialDate(entry.data.date, entry.data.dateEnd)}
  location={formatLocation(entry.data.location)}
  formatLabel={presentation.formatLabel}
  contextLabel={presentation.contextLabel}
  cover={entry.data.cover}
  credits={credits}
  archived={entry.data.status === "archived"}
  socialImage={socialImage}
  publishedTime={entry.data.publishAt}
  modifiedTime={entry.data.updatedAt}
  structuredData={structuredData}
  viewTransitionName={viewTransitionName}
  motion={motion}
>
  <Content components={MDX_COMPONENT_REGISTRY} />
</WorkLayout>
