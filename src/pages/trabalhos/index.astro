---
import { getCollection } from "astro:content";

import EditorialImage from "../../components/editorial/EditorialImage.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
import {
  buildInstant,
  formatEditorialDate,
  formatLocation,
  isInPublicCirculation,
  sortWorksByDate,
  workPresentation,
} from "../../lib/content/publication.ts";
import { publicRoutes } from "../../lib/routes/public.ts";
import { configuredSiteUrl } from "../../lib/seo/site-url.ts";
import { worksIndexStructuredData } from "../../lib/seo/structured-data.ts";
import { workCoverViewTransitionName } from "../../lib/view-transitions/work-cover.ts";

const at = buildInstant();
const introduction =
  "Ensaios, coberturas e projetos fotográficos organizados como documentos permanentes.";
const works = sortWorksByDate(
  (await getCollection("trabalhos")).filter((entry) =>
    isInPublicCirculation(entry, at),
  ),
);
const structuredData = worksIndexStructuredData(
  works,
  at,
  configuredSiteUrl(),
  introduction,
);
---

<IndexLayout
  title="Trabalhos"
  introduction={introduction}
  count={works.length}
  family="trabalhos"
  structuredData={structuredData}
  viewTransitions
>
  <ol class="works-index" role="list">
    {
      works.map((work, index) => {
        const presentation = workPresentation(work.id, work.data);
        const href = publicRoutes.trabalho(work.data.slug);
        const photoCount = work.data.gallery.length;
        const viewTransitionName = workCoverViewTransitionName(work.data.slug);
        return (
          <li
            class:list={[
              "works-index__item",
              { "works-index__item--lead": index === 0 },
            ]}
          >
            <article>
              <div class="works-index__media">
                <a
                  href={href}
                  aria-label={`Abrir ${work.data.title} — ${photoCount} fotos`}
                >
                  <EditorialImage
                    asset={work.data.cover}
                    layout={index === 0 ? "lead" : "sequence"}
                    priority={index === 0}
                    showCaption={false}
                    viewTransitionName={viewTransitionName}
                  />
                  <span class="works-index__photo-count" aria-hidden="true">
                    <span class="works-index__photo-count-value number-stable">
                      {photoCount}
                    </span>
                    <span class="works-index__photo-count-label">
                      Fotografias
                    </span>
                  </span>
                </a>
              </div>
              <div class="works-index__copy">
                <p class="archive-marker type-meta number-stable">
                  <span>{work.data.archiveNumber}</span>
                  <span>
                    {formatEditorialDate(work.data.date, work.data.dateEnd)}
                  </span>
                </p>
                <p class="works-index__category type-label">
                  {presentation.formatLabel}
                </p>
                <h2 class="works-index__title type-project">
                  <a href={href}>{work.data.title}</a>
                </h2>
                <p class="works-index__summary type-intro">
                  {work.data.summary}
                </p>
                <dl class="works-index__metadata type-meta">
                  {work.data.location && (
                    <div>
                      <dt>Cidade</dt>
                      <dd>{formatLocation(work.data.location)}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Formato</dt>
                    <dd>{presentation.formatLabel}</dd>
                  </div>
                  <div>
                    <dt>Contexto</dt>
                    <dd>{presentation.contextLabel}</dd>
                  </div>
                </dl>
                <a class="works-index__cta link-editorial" href={href}>
                  Ver trabalho
                </a>
              </div>
            </article>
          </li>
        );
      })
    }
  </ol>
</IndexLayout>

<script>
  import { initializeEditorialTitleMotion } from "../../lib/motion/editorial-title.ts";
  import { MOTION_LIFECYCLE_EVENTS } from "../../lib/motion/config.ts";

  const root = document.querySelector<HTMLElement>(
    "[data-editorial-title-motion]",
  );

  if (root) {
    const cleanup = initializeEditorialTitleMotion(root);
    window.addEventListener(MOTION_LIFECYCLE_EVENTS.pageHide, cleanup, {
      once: true,
    });
  }
</script>
