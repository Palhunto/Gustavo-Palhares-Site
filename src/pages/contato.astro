---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicRoutes } from "../lib/routes/public.ts";

const contactChannels = [
  {
    label: "WhatsApp",
    value: "(14) 99717-3521",
    href: "https://wa.me/5514997173521",
    accessibleName: "Conversar pelo WhatsApp no número (14) 99717-3521",
  },
  {
    label: "Instagram",
    value: "@palhares.doc",
    href: "https://www.instagram.com/palhares.doc/",
    accessibleName: "Abrir o Instagram @palhares.doc",
  },
  {
    label: "E-mail",
    value: "gustavo.palhares49@gmail.com",
    href: "mailto:gustavo.palhares49@gmail.com",
    accessibleName: "Enviar e-mail para gustavo.palhares49@gmail.com",
  },
] as const;
---

<BaseLayout
  title="Contato"
  description="Canais públicos para projetos fotográficos, parcerias, imprensa e colaborações com Gustavo Palhares."
  robots="index, follow"
  variant="contact-page"
>
  <article class="contact-page" aria-labelledby="titulo-contato">
    <header class="contact-page__section-heading">
      <span class="contact-page__number number-stable" aria-hidden="true"
        >03</span
      >
      <p id="titulo-secao-contato">Contato</p>
      <span class="contact-page__heading-rule" aria-hidden="true"></span>
      <p class="contact-page__heading-note type-label">
        Canais públicos e projetos
      </p>
    </header>

    <section
      class="contact-page__main"
      aria-labelledby="titulo-contato"
      aria-describedby="descricao-contato"
    >
      <div class="contact-page__introduction">
        <h1 id="titulo-contato">Contato</h1>
        <p id="descricao-contato">
          Para projetos fotográficos, coberturas, retratos, editoriais,
          fotografia de produtos, parcerias e colaborações, entre em contato por
          um dos canais abaixo.
        </p>
      </div>

      <address class="contact-page__channels" aria-label="Canais de contato">
        {
          contactChannels.map((channel) => (
            <a
              class="contact-page__channel"
              href={channel.href}
              aria-label={channel.accessibleName}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="contact-page__channel-label type-label">
                {channel.label}
              </span>
              <span class="contact-page__channel-value">{channel.value}</span>
            </a>
          ))
        }
      </address>
    </section>

    <aside class="contact-page__prompt" aria-labelledby="titulo-conversa">
      <h2 id="titulo-conversa">Para agilizar a conversa</h2>
      <p>
        Inclua, quando possível, o tipo de trabalho, a data prevista, a cidade,
        o prazo e uma breve descrição do projeto.
      </p>
    </aside>

    <section class="contact-page__index" aria-labelledby="titulo-indice">
      <header
        class="contact-page__section-heading contact-page__section-heading--index"
      >
        <span class="contact-page__number number-stable" aria-hidden="true"
          >04</span
        >
        <h2 id="titulo-indice">Índice</h2>
        <span class="contact-page__heading-rule" aria-hidden="true"></span>
        <p class="contact-page__heading-note type-label">Navegue por tudo</p>
      </header>

      <div class="contact-page__index-grid">
        <article class="contact-page__index-item">
          <h3>Projetos fotográficos</h3>
          <p>Eventos, shows, esporte, retratos, editoriais e produtos.</p>
          <a
            class="contact-page__index-action type-nav"
            href={publicRoutes.trabalhosIndex}
          >
            Ver trabalhos <span aria-hidden="true">⟶</span>
          </a>
        </article>

        <article class="contact-page__index-item">
          <h3>Parcerias e imprensa</h3>
          <p>
            Pautas, publicações, artistas, bandas, espaços culturais e projetos
            independentes.
          </p>
        </article>

        <article class="contact-page__index-item">
          <h3>Outros contatos</h3>
          <p>Convites, propostas, licenciamento de imagens e colaborações.</p>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>
